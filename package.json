{
  "name": "@icefairy/pi-mcp-adapter",
  "version": "2.29.3",
  "description": "MCP (Model Context Protocol) adapter extension for Pi coding agent",
  "type": "module",
  "types": "./index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./index.ts",
      "default": "./index.ts"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    },
    "./oauth": {
      "types": "./oauth.ts",
      "import": "./oauth.ts",
      "default": "./oauth.ts"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "default": "./dist/config.js"
    }
  },
  "license": "MIT",
  "author": "Nico Bailon",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "pi-mcp-adapter": "cli.js"
  },
  "scripts": {
    "build:public": "tsc -p tsconfig.public.json",
    "prepack": "npm run build:public",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:vitest": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "postinstall": "node scripts/apply-intranet-http-patch.mjs || true"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicobailon/pi-mcp-adapter.git"
  },
  "keywords": [
    "pi-package",
    "pi",
    "mcp",
    "model-context-protocol",
    "oauth",
    "bearer",
    "sse",
    "streamable-http"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "cli.js",
    "agent-dir.ts",
    "config.ts",
    "errors.ts",
    "failure-backoff.ts",
    "logger.ts",
    "mcp-auth-flow.ts",
    "mcp-auth.ts",
    "mcp-bearer-store.ts",
    "mcp-oauth-provider.ts",
    "mcp-probe.ts",
    "mcp-references.ts",
    "oauth-handler.ts",
    "oauth.ts",
    "runtime-owner.ts",
    "server-manager.ts",
    "state.ts",
    "ts-shape.ts",
    "types.ts",
    "utils.ts",
    "unix-socket-transport.ts",
    "request-headers-command.ts",
    "json-schema-validator.ts",
    "onboarding-state.ts",
    "mcp-keyring-helper.cjs",
    "banner.png",
    "scripts",
    "patches",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "dist"
  ],
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/core": "2.0.0",
    "@napi-rs/keyring": "^1.3.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "cross-spawn": "^7.0.6",
    "open": "^10.2.0",
    "smol-toml": "^1.6.1",
    "strip-json-comments": "^5.0.3",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "optionalDependencies": {
    "recheck": "^4.5.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.0",
    "@earendil-works/pi-ai": ">=0.84.0",
    "@earendil-works/pi-tui": ">=0.84.0",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-tui": "0.84.1",
    "@modelcontextprotocol/conformance": "0.1.16",
    "@types/bun": "^1.0.0",
    "@types/cross-spawn": "6.0.6",
    "@types/node": "20.19.43",
    "@types/open": "^6.2.1",
    "tsx": "^4.21.0",
    "typebox": "1.3.3",
    "typescript": "5.9.3",
    "vitest": "^3.0.0"
  },
  "patchedDependencies": {}
}
